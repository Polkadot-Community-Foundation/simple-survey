{
  "name": "survey-dapp",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build:frontend": "tsc -b && vite build",
    "build:contracts": "cdm build",
    "deploy:contract": "cdm deploy -n devnet && npm run install:contracts",
    "install:contracts": "cdm install -n devnet @polkadot/surveys",
    "deploy:frontend": "npm run build:frontend && polkadot-app-deploy --env devnet --mnemonic \"$MNEMONIC\" --publish ./dist survey.dot",
    "preview": "vite preview"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@parity/product-sdk-address": "0.2.0",
    "@parity/product-sdk-chain-client": "0.12.3",
    "@parity/product-sdk-contracts": "0.10.7",
    "@parity/product-sdk-descriptors": "0.11.0",
    "@parity/product-sdk-host": "0.19.1",
    "@parity/product-sdk-signer": "0.14.4",
    "@parity/product-sdk-tx": "0.4.7",
    "multiformats": "^13.4.2",
    "polkadot-api": "^2.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.9.0",
    "vite": "^8.0.16"
  },
  "overrides": {
    "@polkadot-api/json-rpc-provider": "0.2.0"
  }
}
